   "isDeleted": false,
   "boundElements": null,
   "updated": 1767000000000,
   "link": null,
   "locked": false,
   "text": "Roles are a network topology, not a software architecture.  IPs live in team.env (10.7.16.221 \u2026 10.7.8.104) \u2014 get yours with ./scripts/my_ip.sh",
   "originalText": "Roles are a network topology, not a software architecture.  IPs live in team.env (10.7.16.221 \u2026 10.7.8.104) \u2014 get yours with ./scripts/my_ip.sh",
