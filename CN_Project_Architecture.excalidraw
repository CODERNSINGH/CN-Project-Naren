   "text": "Explanation-only topics (brief says no build needed)",
   "originalText": "Explanation-only topics (brief says no build needed)",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 17,
   "containerId": null,
   "lineHeight": 1.25,
