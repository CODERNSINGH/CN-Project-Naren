   "boundElements": null,
   "updated": 1767000000000,
   "link": null,
   "locked": false,
   "text": "Step 0 everywhere:  git clone https://github.com/CODERNSINGH/CN-Project-Naren.git ~/CN-Project-Naren  \u00b7  cd <your folder>  \u00b7  ./scripts/my_ip.sh \u2192 send IP to lead \u2192 lead runs ./setup_team.sh IP1 IP2 IP3 IP4 team1, pushes \u2192 everyone git pull",
   "originalText": "Step 0 everywhere:  git clone https://github.com/CODERNSINGH/CN-Project-Naren.git ~/CN-Project-Naren  \u00b7  cd <your folder>  \u00b7  ./scripts/my_ip.sh \u2192 send IP to lead \u2192 lead runs ./setup_team.sh IP1 IP2 IP3 IP4 team1, pushes \u2192 everyone git pull",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
