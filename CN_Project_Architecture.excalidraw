   "link": null,
   "locked": false,
   "text": "blue = DNS (Mac 1)\ngreen = edge / TLS / load balancer (Mac 2)\norange = backends (Mac 3, 4)\npurple = TLS handshake / security\nred = failure / blocked\nyellow = Phase 2 items\ncyan = LAN\ndashed = optional / standby / next request",
   "originalText": "blue = DNS (Mac 1)\ngreen = edge / TLS / load balancer (Mac 2)\norange = backends (Mac 3, 4)\npurple = TLS handshake / security\nred = failure / blocked\nyellow = Phase 2 items\ncyan = LAN\ndashed = optional / standby / next request",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "lineHeight": 1.25,
