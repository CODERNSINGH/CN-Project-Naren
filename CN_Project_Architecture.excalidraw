   "isDeleted": false,
   "boundElements": null,
   "updated": 1767000000000,
   "link": null,
   "locked": false,
   "text": "Every step can be proven with a tool: dig (DNS) \u00b7 tcp.flags.syn (TCP) \u00b7 tls.handshake (TLS) \u00b7 curl -v / DevTools (HTTP) \u00b7 X-Backend / X-Edge headers (LB)",
   "originalText": "Every step can be proven with a tool: dig (DNS) \u00b7 tcp.flags.syn (TCP) \u00b7 tls.handshake (TLS) \u00b7 curl -v / DevTools (HTTP) \u00b7 X-Backend / X-Edge headers (LB)",
   "fontSize": 15,
