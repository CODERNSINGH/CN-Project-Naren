  },
  {
   "id": "el0319",
   "type": "text",
   "x": 922,
   "y": 4239.0,
   "width": 856,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1550807105,
   "version": 1,
   "versionNonce": 785877047,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1767000000000,
   "link": null,
   "locked": false,
   "text": "Standby nginx on Mac 3 (configure_nginx.sh standby) with same config + cert; header X-Edge: standby.\nLower TTL to 30 s, then TTL=30 APP_IP=10.7.1.186 ./setup_dnsmasq.sh primary; watch ./scripts/demo_edge.sh.\nOBSERVE: cached clients still hit mac2 until TTL expires; new lookups reach standby.\nOptional: nginx -s stop on Mac 2 \u2192 service still up.",
   "originalText": "Standby nginx on Mac 3 (configure_nginx.sh standby) with same config + cert; header X-Edge: standby.\nLower TTL to 30 s, then TTL=30 APP_IP=10.7.1.186 ./setup_dnsmasq.sh primary; watch ./scripts/demo_edge.sh.\nOBSERVE: cached clients still hit mac2 until TTL expires; new lookups reach standby.\nOptional: nginx -s stop on Mac 2 \u2192 service still up.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
  },
