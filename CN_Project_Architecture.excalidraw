   "boundElements": null,
   "updated": 1767000000000,
   "link": null,
   "locked": false,
   "text": "BREAK: Ctrl+C Backend A\nSEE: all answers X-Backend: B, status 200\nWHY: nginx marks A failed (max_fails/fail_timeout) and\n  proxy_next_upstream retries on B; first request may wait \u22642 s\n  connect timeout\nLAYER: upstream",
   "originalText": "BREAK: Ctrl+C Backend A\nSEE: all answers X-Backend: B, status 200\nWHY: nginx marks A failed (max_fails/fail_timeout) and\n  proxy_next_upstream retries on B; first request may wait \u22642 s\n  connect timeout\nLAYER: upstream",
   "fontSize": 14,
