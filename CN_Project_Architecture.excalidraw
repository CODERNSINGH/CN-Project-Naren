  {
   "id": "el0304",
   "type": "text",
   "x": 1900,
   "y": 3765.0,
   "width": 780,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 307045059,
   "version": 1,
   "versionNonce": 543544937,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1767000000000,
   "link": null,
   "locked": false,
   "text": "\u2022 solid = normal path, dashed = failover / optional path\n\u2022 Ext A removes DNS as a single point of failure\n\u2022 Ext D keeps service alive when one backend dies\n\u2022 Ext E removes the edge SPOF by DNS cutover\n\u2022 Ext C hides backends from every client except the edge\n\u2022 remaining SPOFs: the LAN/router, the CA, DNS cache time (TTL)",
   "originalText": "\u2022 solid = normal path, dashed = failover / optional path\n\u2022 Ext A removes DNS as a single point of failure\n\u2022 Ext D keeps service alive when one backend dies\n\u2022 Ext E removes the edge SPOF by DNS cutover\n\u2022 Ext C hides backends from every client except the edge\n\u2022 remaining SPOFs: the LAN/router, the CA, DNS cache time (TTL)",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
  },
