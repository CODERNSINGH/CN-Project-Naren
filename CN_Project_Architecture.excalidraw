   "link": null,
   "locked": false,
   "text": "BREAK: client DNS \u2192 unused IP\nSEE: dig times out; ping 10.7.2.91 still works; curl --resolve\n  works\nWHY: DNS and IP are independent layers; DNS only maps names\u2192IPs\nLAYER: application (DNS)",
   "originalText": "BREAK: client DNS \u2192 unused IP\nSEE: dig times out; ping 10.7.2.91 still works; curl --resolve\n  works\nWHY: DNS and IP are independent layers; DNS only maps names\u2192IPs\nLAYER: application (DNS)",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
