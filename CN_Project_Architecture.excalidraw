   "updated": 1767000000000,
   "link": null,
   "locked": false,
   "text": "Ext A \u2014 Backup DNS resolver",
   "originalText": "Ext A \u2014 Backup DNS resolver",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 17,
