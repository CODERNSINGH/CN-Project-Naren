  },
  {
   "id": "el0310",
   "type": "text",
   "x": 922,
   "y": 4070.25,
   "width": 856,
   "height": 87.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1046384558,
   "version": 1,
   "versionNonce": 349599955,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1767000000000,
   "link": null,
   "locked": false,
   "text": "TTL=30 ./scripts/setup_dnsmasq.sh primary (host-record with TTL).\nResolve from client, change record to another IP, run ./scripts/demo_ttl.sh \u2192 old answer persists \u2264 TTL, then\n  new.\nFlush: sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder \u2192 immediate change.\nEXPLAIN: lower TTL before migrations (Route 53 blue/green).",
   "originalText": "TTL=30 ./scripts/setup_dnsmasq.sh primary (host-record with TTL).\nResolve from client, change record to another IP, run ./scripts/demo_ttl.sh \u2192 old answer persists \u2264 TTL, then\n  new.\nFlush: sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder \u2192 immediate change.\nEXPLAIN: lower TTL before migrations (Route 53 blue/green).",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "lineHeight": 1.25,
