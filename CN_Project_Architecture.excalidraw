   "text": "1. Network topology \u2014 four roles on ONE private LAN (one subnet, no router hop between Macs)",
   "originalText": "1. Network topology \u2014 four roles on ONE private LAN (one subnet, no router hop between Macs)",
   "fontSize": 30,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 30,
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
  },
  {
   "id": "el0007",
   "type": "text",
   "x": 20,
   "y": 240,
   "width": 2660,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
