  },
  {
   "id": "el0307",
   "type": "text",
   "x": 12,
   "y": 4070.25,
   "width": 856,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 471561267,
   "version": 1,
   "versionNonce": 1603487569,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1767000000000,
   "link": null,
   "locked": false,
   "text": "Second dnsmasq on Mac 3 with identical records; clients list both resolvers (set_dns.sh both).\nStop dnsmasq on Mac 1 \u2192 names still resolve via backup (short delay: resolver tries servers in order after a\n  timeout).\nEXPLAIN: DNS failure (resolution stops) vs application failure (resolution works, service down).",
   "originalText": "Second dnsmasq on Mac 3 with identical records; clients list both resolvers (set_dns.sh both).\nStop dnsmasq on Mac 1 \u2192 names still resolve via backup (short delay: resolver tries servers in order after a\n  timeout).\nEXPLAIN: DNS failure (resolution stops) vs application failure (resolution works, service down).",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
  },
