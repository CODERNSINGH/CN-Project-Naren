  },
  {
   "id": "el0176",
   "type": "text",
   "x": 1392,
   "y": 2313.25,
   "width": 1296,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1588865204,
   "version": 1,
   "versionNonce": 1725129599,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1767000000000,
   "link": null,
   "locked": false,
   "text": "HTTP/1.1: one request at a time per connection \u00b7 HTTP/2: multiplexed streams, binary framing, HPACK, but TCP head-of-line blocking \u00b7 HTTP/3: QUIC over UDP/443, TLS 1.3\n  built in.\nEmail: SMTP 25/587/465 sends/relays \u00b7 IMAP 143/993 keeps mail on server \u00b7 POP3 110/995 downloads \u00b7 routing uses DNS MX records.\nCDN: replicate cacheable content at edge nodes, DNS/anycast steers users, Cache-Control/ETag decide freshness \u2014 our nginx is one edge node.",
   "originalText": "HTTP/1.1: one request at a time per connection \u00b7 HTTP/2: multiplexed streams, binary framing, HPACK, but TCP head-of-line blocking \u00b7 HTTP/3: QUIC over UDP/443, TLS 1.3\n  built in.\nEmail: SMTP 25/587/465 sends/relays \u00b7 IMAP 143/993 keeps mail on server \u00b7 POP3 110/995 downloads \u00b7 routing uses DNS MX records.\nCDN: replicate cacheable content at edge nodes, DNS/anycast steers users, Cache-Control/ETag decide freshness \u2014 our nginx is one edge node.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
  },
