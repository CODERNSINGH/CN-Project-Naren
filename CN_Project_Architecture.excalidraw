   "boundElements": null,
   "updated": 1767000000000,
   "link": null,
   "locked": false,
   "text": "IP: 10.7.2.91   (the only IP clients ever learn)\nnginx :8443 HTTPS (8080 \u2192 redirect)\nterminates TLS, cert = app.team1.test (SAN)\nupstream round-robin \u2192 MAC3:3001, MAC4:3002\npassive health: max_fails=2 fail_timeout=10s\nadds header X-Edge: mac2\nowns the team CA (make_certs.sh, serve_ca.sh)\nCloud \u2248 AWS ALB / CDN edge",
   "originalText": "IP: 10.7.2.91   (the only IP clients ever learn)\nnginx :8443 HTTPS (8080 \u2192 redirect)\nterminates TLS, cert = app.team1.test (SAN)\nupstream round-robin \u2192 MAC3:3001, MAC4:3002\npassive health: max_fails=2 fail_timeout=10s\nadds header X-Edge: mac2\nowns the team CA (make_certs.sh, serve_ca.sh)\nCloud \u2248 AWS ALB / CDN edge",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "lineHeight": 1.25,
