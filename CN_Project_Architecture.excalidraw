   "versionNonce": 1510006083,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1767000000000,
   "link": null,
   "locked": false,
   "text": "Faculty breaks one thing; diagnose OUT LOUD in layer order, partial credit for method.\n./scripts/diagnose.sh runs: LAN/IP \u2192 DNS \u2192 TCP \u2192 TLS \u2192 HTTP/app \u2192 backends and prints the suspect for the\n  first FAIL.\nCheck logs: tail -f $(brew --prefix)/var/log/nginx/error.log \u00b7 tail /tmp/dnsmasq.log",
   "originalText": "Faculty breaks one thing; diagnose OUT LOUD in layer order, partial credit for method.\n./scripts/diagnose.sh runs: LAN/IP \u2192 DNS \u2192 TCP \u2192 TLS \u2192 HTTP/app \u2192 backends and prints the suspect for the\n  first FAIL.\nCheck logs: tail -f $(brew --prefix)/var/log/nginx/error.log \u00b7 tail /tmp/dnsmasq.log",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
