# ============================================================
#  team.env  -  EDIT THIS ONCE (or run ./setup_team.sh), then ./sync.sh, commit, push
#  Every Mac gets an identical copy of this file.
#  Network: campus 10.7.0.0/19 (mask 255.255.224.0), gateway 10.7.0.1 -> NEVER use the gateway as a Mac IP
# ============================================================
TEAM=team1                 # domain becomes app.team1.test / api.team1.test

# Verified with `ipconfig getifaddr en0` on each Mac (see ip.md / GUIDE_END_TO_END.md)
MAC1_IP=10.7.16.221        # Mac 1: Mohan    - DNS server + test client
MAC2_IP=10.7.2.91          # Mac 2: Narendra - nginx edge / load balancer / TLS / CA
MAC3_IP=10.7.1.186         # Mac 3: Keshav   - Backend A (3001) + backup DNS + standby edge
MAC4_IP=10.7.8.104         # Mac 4: Mayank   - Backend B (3002)

BACKUP_DNS_IP=10.7.1.186   # Phase 2 / Ext A: second dnsmasq (Mac 3)
STANDBY_EDGE_IP=10.7.1.186 # Phase 2 / Ext E: standby nginx (Mac 3)

NET_SERVICE=Wi-Fi          # name from: networksetup -listallhardwareports
EDGE_HTTPS_PORT=8443       # use 443 only if you run nginx with sudo
EDGE_HTTP_PORT=8080

MAC1_OWNER=Mohan
MAC2_OWNER=Narendra
MAC3_OWNER=Keshav
MAC4_OWNER=Mayank
