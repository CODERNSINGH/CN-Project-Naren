# ============================================================
#  team.env  -  EDIT THIS ONCE, then run ./sync.sh
#  Every Mac gets an identical copy of this file.
# ============================================================
TEAM=team1                 # domain becomes app.team1.test / api.team1.test

# Fill these from `./scripts/check_lan.sh` on each Mac (Task A)
MAC1_IP=192.168.1.11       # Mac 1: DNS server + test client
MAC2_IP=192.168.1.12       # Mac 2: nginx edge / load balancer / TLS  (THIS laptop)
MAC3_IP=192.168.1.13       # Mac 3: Backend A (3001) + backup DNS + standby edge
MAC4_IP=192.168.1.14       # Mac 4: Backend B (3002)

BACKUP_DNS_IP=192.168.1.13 # Phase 2 / Ext A: second dnsmasq (default: Mac 3)
STANDBY_EDGE_IP=192.168.1.13  # Phase 2 / Ext E: standby nginx (default: Mac 3)

NET_SERVICE=Wi-Fi          # name from: networksetup -listallhardwareports
EDGE_HTTPS_PORT=8443       # use 443 only if you run nginx with sudo
EDGE_HTTP_PORT=8080
